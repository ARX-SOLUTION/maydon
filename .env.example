# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Numeric Telegram user id of the default owner-admin (get it from @userinfobot).
# On boot this user is created/kept as the "owner" admin automatically — this is
# how you add the first admin. Leave empty for no default admin.
ADMIN_TELEGRAM_ID=

# Public URL of the deployed app / Mini App (used in bot buttons and the webhook)
MINI_APP_URL=https://maydon.xam1dullo.deno.net
